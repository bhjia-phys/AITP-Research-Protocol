{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.txt\"",
            "commandWindows": "type \"${CLAUDE_PLUGIN_ROOT}\\hooks\\session-start.txt\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compact.txt\"",
            "commandWindows": "type \"${CLAUDE_PLUGIN_ROOT}\\hooks\\post-compact.txt\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tidy.py\" --reply-end",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\hooks\\tidy.py\" --reply-end",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tidy.py\" --turn-start",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\hooks\\tidy.py\" --turn-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
